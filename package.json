{
  "name": "@icco/robot.villas",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --fix src/ && pnpm fmt:yaml && pnpm typecheck",
    "fmt:yaml": "find . \\( -name '*.yml' -o -name '*.yaml' \\) -not -path './node_modules/*' -not -path './.next/*' -not -name 'pnpm-lock.yaml' -exec yq -iP '.' {} \\;",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "validate-feeds": "tsx scripts/validate-feeds.ts"
  },
  "dependencies": {
    "@fedify/fedify": "^2.3.6",
    "@fedify/next": "^2.3.6",
    "@fedify/postgres": "^2.3.6",
    "@fedify/vocab": "^2.3.6",
    "@google/genai": "^2.22.0",
    "@heroicons/react": "^2.2.0",
    "@icco/react-common": "^2026.10913.3",
    "@js-temporal/polyfill": "^0.5.1",
    "@logtape/logtape": "^2.3.4",
    "daisyui": "^5.7.37",
    "drizzle-orm": "^0.45.2",
    "escape-html": "^1.0.3",
    "js-yaml": "^5.4.2",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rss-parser": "^3.13.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/escape-html": "^1.0.4",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "postcss": "^8.5.28",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
